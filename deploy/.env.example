# Required. 16+ random characters; encrypts provider keys and signs sessions. Back it up:
# losing it makes stored provider keys unreadable.  openssl rand -hex 32
MASTER_KEY=
# Operator account created on first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# The URL users reach the gateway at (https:// enables secure cookies; used for SSO redirects).
PUBLIC_URL=http://localhost:8080
# Optional
# ALLOW_SIGNUP=false
# SIGNUP_PREPAID=false
# METRICS_TOKEN=
# LOG_RETENTION_DAYS=14
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAINS=example.com
